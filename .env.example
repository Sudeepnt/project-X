# Copy to .env and adjust. Every variable is optional in development.
# In staging/production the app refuses to start with development secrets.

PX_ENV=dev                       # dev | test | staging | prod
PX_BASE_URL=http://localhost:8010  # public URL of the API (links, landing pages, OAuth callbacks)
PX_WEB_URL=http://localhost:5173   # where the cockpit runs
PX_LOG_JSON=false

PX_DATABASE_URL=postgresql+asyncpg://projectx:projectx@localhost:5432/projectx

# Security: generate with `python -c "import secrets,base64;print(secrets.token_urlsafe(48))"`
# and `python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"`.
PX_SECRET_KEY=
PX_VAULT_MASTER_KEY=
PX_COOKIE_SECURE=false

# Plan for new businesses (dev default: scale, so everything is unlocked)
# PX_DEFAULT_PLAN=free

# Model gateway rungs: "provider:model". Providers: offline | anthropic | openai (any OpenAI-compatible endpoint).
# Offline drafts need no key, so the whole product runs locally without spending anything.
PX_LLM_SMALL=offline:draft-small
PX_LLM_MID=offline:draft-mid
PX_LLM_FRONTIER=offline:draft-frontier
PX_LLM_HARD=offline:draft-hard
# Recommended: open-weight models for everything (served by vLLM, Ollama, or a host like Together/Fireworks),
# and Claude only for hard jobs (coding, long multi-step reasoning). Code enforces this: with
# PX_LLM_CLAUDE_FOR_HARD_ONLY=true (the default) an anthropic model is never used unless a job is marked hard.
# PX_OPENAI_COMPAT_BASE_URL=http://localhost:8001/v1
# PX_OPENAI_COMPAT_API_KEY=
# PX_LLM_SMALL=openai:<small open model>
# PX_LLM_MID=openai:<mid open model>
# PX_LLM_FRONTIER=openai:<largest open model you serve>
# PX_ANTHROPIC_API_KEY=sk-ant-...
# PX_LLM_HARD=anthropic:claude-opus-5-5
# PX_LLM_CLAUDE_FOR_HARD_ONLY=true
# Price overrides (USD per million tokens): {"model": [input, output, cache_read, cache_write]}
# PX_LLM_PRICES={"qwen3:8b": [0.05, 0.1, 0, 0]}

# Email (Mailpit locally: brew install mailpit && mailpit → http://localhost:8025)
PX_SMTP_HOST=localhost
PX_SMTP_PORT=1025
PX_EMAIL_FROM=Project X <no-reply@projectx.local>

# Platform apps — fill in as each platform approves the app (see docs/modules/gtm.md).
# PX_META_APP_ID=
# PX_META_APP_SECRET=
# PX_META_WEBHOOK_VERIFY_TOKEN=
# PX_THREADS_APP_ID=
# PX_THREADS_APP_SECRET=
# PX_X_CLIENT_ID=
# PX_X_CLIENT_SECRET=
# PX_LINKEDIN_CLIENT_ID=
# PX_LINKEDIN_CLIENT_SECRET=
# PX_TIKTOK_CLIENT_KEY=
# PX_TIKTOK_CLIENT_SECRET=
# PX_GOOGLE_CLIENT_ID=
# PX_GOOGLE_CLIENT_SECRET=
# PX_GOOGLE_ADS_DEVELOPER_TOKEN=
# PX_MICROSOFT_CLIENT_ID=
# PX_MICROSOFT_CLIENT_SECRET=
# PX_PINTEREST_APP_ID=
# PX_PINTEREST_APP_SECRET=
# PX_TELEGRAM_WEBHOOK_SECRET=
# PX_DISCORD_APPLICATION_ID=
# PX_DISCORD_PUBLIC_KEY=
# PX_DISCORD_BOT_TOKEN=
# PX_DISCORD_CLIENT_SECRET=     # for the bot install (OAuth code exchange); then run `projectx discord-commands`
# Interactions endpoint URL to set in the Discord developer portal: {PX_BASE_URL}/webhooks/discord/interactions
# PX_AYRSHARE_API_KEY=

# Billing (Project X charging its customers) — Dodo Payments
# PX_DODO_API_KEY=
# PX_DODO_WEBHOOK_SECRET=
# PX_DODO_ENVIRONMENT=test_mode
# PX_DODO_PRODUCT_IDS={"autopilot":"pdt_...","growth":"pdt_...","scale":"pdt_..."}
# PX_DODO_AD_SHARE_EVENT=ad_spend_share   # usage meter for Scale's share of ad spend (USD)

# --- file storage (local disk by default; S3-compatible once you run more than one server) ---
# PX_BLOB_BACKEND=s3
# PX_S3_BUCKET=
# PX_S3_REGION=
# PX_S3_ENDPOINT_URL=          # empty for AWS; e.g. https://<account>.r2.cloudflarestorage.com
# PX_S3_ACCESS_KEY_ID=
# PX_S3_SECRET_ACCESS_KEY=

# --- behind a load balancer: only its IPs may set X-Forwarded-For ---
# PX_FORWARDED_ALLOW_IPS=10.0.0.0/8
